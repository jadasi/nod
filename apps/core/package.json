{
  "name": "@nod/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm --filter @nod/contract build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @nod/contract build && tsc --noEmit",
    "test": "pnpm --filter @nod/contract build && vitest run",
    "fake-source": "tsx scripts/fake-source.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nod/contract": "workspace:*",
    "hono": "^4.13.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
